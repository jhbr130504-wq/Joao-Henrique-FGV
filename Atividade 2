#include <stdio.h>
#include <string.h>

typedef char* string;

void replace(string input, string output) {
    for (int i = 0; i < strlen(input); i++) {
        switch (input[i]) {
            case 'a':
                output[i] = '6';
                break;
            case 'e':
                output[i] = '3';
                break;
            case 'i':
                output[i] = '1';
                break;
            case 'o':
                output[i] = '0';
                break;
            case 'u':
                output[i] = 'u';
                break;
            default:
                output[i] = input[i];
                break;
        }
    }
    output[strlen(input)] = '\0';
}

int main(int argc, string argv[]) {

    char buffer[100];

    if (argc != 2) {
        printf("Erro: forneça uma palavra como argumento.\n");
        return 1;
    }

    replace(argv[1], buffer);

    printf("%s\n", buffer);

    return 0;
}
